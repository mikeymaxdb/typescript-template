{
    "name": "typescript-template",
    "version": "0.0.0",
    "private": true,
    "description": "A starter template for typescript projects",
    "homepage": "https://github.com/mikeymaxdb/typescript-template#readme",
    "bugs": {
        "url": "https://github.com/mikeymaxdb/typescript-template/issues"
    },
    "license": "MIT",
    "author": "YOUR NAME HERE",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mikeymaxdb/typescript-template.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "vite build",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "prepare": "husky",
        "start": "vite",
        "test": "vitest",
        "typecheck": "tsc --build --noEmit",
        "typecheck:watch": "tsc --build --noEmit --watch"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "husky": "^9.1.7",
        "jsdom": "^31.0.0",
        "lint-staged": "^17.6.0",
        "oxfmt": "^0.76.0",
        "oxlint": "^1.91.0",
        "oxlint-tsgolint": "^7.0.2006",
        "typescript": "~7.0.2",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    },
    "lint-staged": {
        "*": [
            "oxfmt --no-error-on-unmatched-pattern"
        ],
        "src/**/*": [
            "oxlint",
            "vitest related --run"
        ],
        "*.{ts,tsx}": [
            "bash -c 'pnpm run typecheck'"
        ]
    },
    "packageManager": "pnpm@12.18.0"
}
