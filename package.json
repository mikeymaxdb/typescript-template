{
    "name": "typescript-template",
    "version": "0.0.0",
    "description": "A starter template for typescript projects",
    "homepage": "https://github.com/mikeymaxdb/typescript-template#readme",
    "bugs": {
        "url": "https://github.com/mikeymaxdb/typescript-template/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mikeymaxdb/typescript-template.git"
    },
    "license": "MIT",
    "author": "YOUR NAME HERE",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build",
        "format": "prettier -l --write .",
        "format:check": "prettier --check .",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "prepare": "husky",
        "start": "vite",
        "test": "vitest",
        "typecheck": "tsc --build --noEmit",
        "typecheck:watch": "tsc --build --noEmit --watch"
    },
    "dependencies": {
        "oxlint": "^1.74.0",
        "oxlint-tsgolint": "^0.24.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    },
    "devDependencies": {
        "@trivago/prettier-plugin-sort-imports": "^6.0.0",
        "@types/node": "^26.1.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "jsdom": "^29.0.1",
        "lint-staged": "^17.0.5",
        "prettier": "^3.8.1",
        "typescript": "~5.9.3",
        "vite": "^8.0.1",
        "vitest": "^4.0.3"
    },
    "prettier": {
        "printWidth": 90,
        "tabWidth": 4,
        "semi": false,
        "singleQuote": true,
        "plugins": [
            "@trivago/prettier-plugin-sort-imports"
        ],
        "importOrder": [
            "<THIRD_PARTY_MODULES>",
            "^[~/]",
            "^[./]"
        ],
        "importOrderSeparation": true,
        "importOrderSortSpecifiers": true,
        "overrides": [
            {
                "files": "*.md",
                "options": {
                    "printWidth": 80,
                    "proseWrap": "always"
                }
            }
        ]
    },
    "lint-staged": {
        "*": [
            "prettier --write --ignore-unknown"
        ],
        "src/**/*": [
            "oxlint",
            "vitest related --run"
        ],
        "*.{ts,tsx}": [
            "bash -c 'npm run typecheck'"
        ]
    }
}
